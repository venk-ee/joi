# Joi Spatial AI Companion Environment Configuration
# Copy this file to .env and configure your BYOK credentials

# --- BYOK LLM Configuration ---
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_API_KEY=your-openrouter-or-openai-key-here
MODEL_NAME=cognitivecomputations/dolphin-mixtral-8x7b

# --- Speech Configuration (CPU-offloaded) ---
# Kokoro TTS (24kHz Mono)
KOKORO_MODEL_PATH=models/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=models/voices-v1.0.bin
KOKORO_VOICE=af_heart

# Faster-Whisper STT (CPU INT8)
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Server & Observability ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DEBUG=false

# --- Memory Persistence ---
DATABASE_URL=sqlite:///data/joi_memory.db
